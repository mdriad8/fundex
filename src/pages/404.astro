---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found" description="The page you were looking for could not be found." path="/404" noindex>
  <PageHero eyebrow="Error 404" title="We could not find that page" lede="It may have moved, or the link may be out of date.">
    <div class="btn-row">
      <a class="btn btn--primary" href="/">Go to the home page</a>
      <a class="btn btn--secondary" href="/contact">Contact us</a>
    </div>
  </PageHero>
</Base>
