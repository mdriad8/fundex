---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../data/site';
---

<Base title="Message sent" description="Your message to Fundex Global has been sent." path="/contact/thank-you" noindex>
  <PageHero eyebrow="Contact" title="Thank you. Your message has been sent." lede={site.contact.responseTime}>
    <div class="btn-row">
      <a class="btn btn--primary" href="/">Back to home</a>
      <a class="btn btn--secondary" href="/services">Explore our services</a>
    </div>
  </PageHero>
</Base>
