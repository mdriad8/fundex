---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { absolute } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/insights/${post.id}`;
const fmt = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

const articleLd = {
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: absolute(path),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  crumbs={[{ name: 'Insights', path: '/insights' }, { name: post.data.title, path }]}
  extraLd={[articleLd]}
>
  <PageHero eyebrow="Insights" title={post.data.title} lede={post.data.description}>
    <p class="meta">
      By {post.data.author} · <time datetime={post.data.publishedAt.toISOString()}>{fmt.format(post.data.publishedAt)}</time>
    </p>
  </PageHero>
  <article class="section section--white">
    <div class="container container--narrow prose">
      <Content />
    </div>
  </article>
  <CtaBand />
</Base>

<style>
  .meta {
    color: var(--muted-on-dark);
    font-size: var(--step--1);
  }
</style>
