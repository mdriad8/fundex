---
/**
 * Flat SVG redraw of the existing Fund'ex four-tile mark (src/assets/brand/legacy-*.png).
 * Owner to approve or supply master artwork (owner decisions list).
 */
interface Props {
  tone?: 'light' | 'dark';
  size?: number;
}
const { tone = 'light', size = 30 } = Astro.props;
const tile = tone === 'light' ? 'var(--gold-400)' : 'var(--navy-950)';
const tileSoft = tone === 'light' ? 'var(--paper)' : 'var(--navy-800)';
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <g transform="skewY(-14) translate(0 6)">
      <rect x="15" y="2" width="11" height="7" rx="1" fill={tileSoft}></rect>
      <rect x="15" y="11" width="22" height="11" rx="1" fill={tile}></rect>
      <rect x="2" y="15" width="11" height="9" rx="1" fill={tileSoft}></rect>
      <rect x="15" y="24" width="11" height="7" rx="1" fill={tileSoft}></rect>
    </g>
  </svg>
  <span class="logo__word">Fund’ex</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .logo--light {
    color: var(--paper);
  }
  .logo--dark {
    color: var(--navy-950);
  }
  @media (forced-colors: active) {
    rect {
      fill: CanvasText;
    }
  }
</style>
