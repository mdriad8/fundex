---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  size?: 'home' | 'page';
}
const { eyebrow, title, lede, size = 'page' } = Astro.props;
---

<section class:list={['hero', 'on-dark', `hero--${size}`, Astro.slots.has('aside') && 'hero--split']} aria-labelledby="page-title">
  {!Astro.slots.has('aside') && <svg class="hero__grid" aria-hidden="true" focusable="false" preserveAspectRatio="xMaxYMax meet" viewBox="0 0 600 400">
    <defs>
      <linearGradient id="hero-fade" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#C9A76D" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#C9A76D" stop-opacity="0.55"></stop>
      </linearGradient>
    </defs>
    <g stroke="url(#hero-fade)" stroke-width="1" fill="none">
      <path d="M220 400V170h40v230M280 400V110h56v290M356 400V60h44v340M420 400V140h60v260M500 400V90h36v310M556 400V190h44v210"></path>
      <path d="M180 400V250h28v150M236 400V210M300 400V150M380 400V100M450 400V180M520 400V130" stroke-dasharray="2 10"></path>
    </g>
    <g fill="#C9A76D" fill-opacity="0.5">
      <rect x="298" y="180" width="4" height="4"></rect><rect x="378" y="120" width="4" height="4"></rect>
      <rect x="448" y="200" width="4" height="4"></rect><rect x="518" y="150" width="4" height="4"></rect>
      <rect x="378" y="240" width="4" height="4"></rect><rect x="300" y="300" width="4" height="4"></rect>
    </g>
  </svg>}
  <div class="container hero__layout">
    <div class="hero__inner">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 id="page-title">{title}</h1>
      {lede && <p class="lede hero__lede">{lede}</p>}
      <slot />
    </div>
    {Astro.slots.has('aside') && <div class="hero__aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--navy-800);
  }
  .hero--home {
    padding-block: clamp(4rem, 2.5rem + 8vw, 9rem);
  }
  .hero--page {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }
  .hero__grid {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(56%, 46rem);
    height: 100%;
    z-index: -1;
    opacity: 0.8;
  }
  @media (max-width: 899.98px) {
    .hero__grid {
      width: 100%;
      opacity: 0.3;
    }
  }
  .hero__layout {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .hero__aside {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero--split .hero__layout {
      grid-template-columns: 6fr 5fr;
    }
    .hero__aside {
      display: block;
    }
  }
  .hero__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  h1 {
    max-width: 18ch;
    color: var(--paper);
  }
  .hero--page h1 {
    font-size: var(--step-4);
    max-width: 22ch;
  }
  .hero--home h1 {
    font-size: clamp(2.5rem, 1.6rem + 4.4vw, 5rem);
  }
  .hero__lede {
    max-width: 38rem;
  }
</style>
