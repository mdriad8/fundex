---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Have a plan that needs to move?',
  text = 'Tell us where you are and what you are trying to achieve. If we are not the right fit, we will say so.',
} = Astro.props;
---

<section class="cta-band on-dark on-dark--raised" aria-labelledby="cta-title">
  <div class="container cta-band__inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href="/contact">Start a conversation</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-8);
  }
  .cta-band__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }
  }
  h2 {
    margin-bottom: var(--space-3);
  }
</style>
