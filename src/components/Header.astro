---
import Logo from './Logo.astro';
import { nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="site-header on-dark">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <Logo tone="light" />
      <span class="visually-hidden"> (Fundex Global home page)</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="menu-toggle__label">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main" data-menu>
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/contact" class="btn btn--gold site-nav__cta">Start a conversation</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const mq = window.matchMedia('(min-width: 900px)');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    mq.addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--navy-800);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }
  .site-header__brand {
    text-decoration: none;
    display: inline-flex;
    padding: var(--space-2) 0;
  }
  .site-nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-1);
  }
  .site-nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    color: var(--paper);
    text-decoration: none;
    font-weight: 500;
    border-radius: var(--radius-sm);
  }
  .site-nav a:not(.btn):hover {
    color: var(--gold-300);
  }
  .site-nav a[aria-current='page'] {
    color: var(--gold-400);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .menu-toggle {
    display: none;
  }

  /* Desktop */
  @media (min-width: 900px) {
    .site-nav {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }
  }

  /* Mobile: hidden behind a disclosure button. Without JS, Base.astro's <noscript> style shows the nav and hides the button. */
  @media (max-width: 899.98px) {
    .site-header__inner {
      flex-wrap: wrap;
    }
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 44px;
      min-width: 44px;
      padding: 0 var(--space-3);
      background: transparent;
      border: 1px solid var(--navy-800);
      border-radius: var(--radius-sm);
      color: var(--paper);
      cursor: pointer;
      font-weight: 600;
    }
    .menu-toggle__bars,
    .menu-toggle__bars::before,
    .menu-toggle__bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: currentColor;
      position: relative;
      transition: transform 150ms ease;
    }
    .menu-toggle__bars::before,
    .menu-toggle__bars::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .menu-toggle__bars::before {
      top: -6px;
    }
    .menu-toggle__bars::after {
      top: 6px;
    }
    .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
      background: transparent;
    }
    .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
    .site-nav {
      flex-basis: 100%;
      padding-bottom: var(--space-4);
    }
    .site-nav {
      display: none;
    }
    .site-nav.is-open {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
      margin-bottom: var(--space-4);
    }
    .site-nav a:not(.btn) {
      width: 100%;
      font-size: var(--step-1);
      border-bottom: 1px solid var(--navy-800);
      border-radius: 0;
      padding: 0;
    }
    .site-nav__cta {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__bars,
    .menu-toggle__bars::before,
    .menu-toggle__bars::after {
      transition: none;
    }
  }
</style>
