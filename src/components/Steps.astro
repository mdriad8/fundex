---
import { engagementSteps } from '../data/site';
---

<ol class="steps" role="list">
  {
    engagementSteps.map((s) => (
      <li class="step">
        <span class="step__num" aria-hidden="true">{s.step}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .step {
    border-top: 2px solid var(--gold-400);
    padding-top: var(--space-5);
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .step__num {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--gold-400);
  }
  .step p {
    color: var(--muted-on-dark);
  }
</style>
