---
/**
 * Brand signature graphic: "strategy meets execution".
 * Scattered, faint lines on the left (complex challenges) converge into one gold path that
 * steps through the four engagement stages. Purely decorative: the same content is in the
 * "How we work" section as real text, so this is aria-hidden.
 */
import { engagementSteps } from '../data/site';
const nodes = [
  { x: 250, y: 300 },
  { x: 330, y: 230 },
  { x: 410, y: 160 },
  { x: 490, y: 90 },
];
---

<svg class="path-graphic" viewBox="0 0 560 380" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="pg-converge" x1="0" x2="1">
      <stop offset="0" stop-color="#AAB6C6" stop-opacity="0.05"></stop>
      <stop offset="1" stop-color="#AAB6C6" stop-opacity="0.45"></stop>
    </linearGradient>
  </defs>

  <!-- Complexity: many tentative lines -->
  <g stroke="url(#pg-converge)" stroke-width="1.25" fill="none" stroke-linecap="round">
    <path d="M10 60 C 90 80, 140 210, 250 300"></path>
    <path d="M10 120 C 80 140, 150 250, 250 300"></path>
    <path d="M10 190 C 100 170, 160 300, 250 300"></path>
    <path d="M10 250 C 90 330, 170 260, 250 300"></path>
    <path d="M10 320 C 110 360, 180 320, 250 300"></path>
    <path d="M10 360 C 120 300, 190 360, 250 300"></path>
  </g>
  <g fill="#AAB6C6" fill-opacity="0.35">
    <circle cx="10" cy="60" r="3"></circle><circle cx="10" cy="120" r="3"></circle><circle cx="10" cy="190" r="3"></circle>
    <circle cx="10" cy="250" r="3"></circle><circle cx="10" cy="320" r="3"></circle><circle cx="10" cy="360" r="3"></circle>
  </g>

  <!-- Execution: one clear stepped path -->
  <path
    d="M250 300 H290 V230 H370 V160 H450 V90 H540"
    fill="none"
    stroke="#C9A76D"
    stroke-width="3"
    stroke-linejoin="round"
    stroke-linecap="round"></path>
  {
    nodes.map((n, i) => (
      <g>
        <circle cx={n.x} cy={n.y} r="9" fill="#0B1422" stroke="#C9A76D" stroke-width="3" />
        <text x={n.x} y={n.y + 34} text-anchor="middle" class="pg-label">
          {engagementSteps[i]!.title}
        </text>
      </g>
    ))
  }
  <path d="M528 78 L544 90 L528 102" fill="none" stroke="#C9A76D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>

<style>
  .path-graphic {
    width: 100%;
    height: auto;
  }
  .pg-label {
    fill: #dcc296;
    font-family: var(--font-text);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  @media (forced-colors: active) {
    .path-graphic {
      display: none;
    }
  }
</style>
