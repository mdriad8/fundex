# Contact form delivery (Resend: https://resend.com). If any of these are missing, the form
# returns HTTP 503 and tells the visitor to email instead. It never shows a false success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@fundexglobal.vc
# Must be an address on a domain verified in Resend, e.g. "Fundex Global website <web@fundexglobal.vc>"
CONTACT_FROM_EMAIL=

# Shared rate limiting across serverless instances (Upstash Redis REST). Optional but recommended:
# without it, limits are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string used to salt the hashed IP/email rate-limit keys.
RATE_LIMIT_SALT=

# Optional Cloudflare Turnstile (privacy-friendly CAPTCHA alternative). Set BOTH to enable.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
